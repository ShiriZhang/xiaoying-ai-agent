# Copy to .env. Models/executor are implemented; HTTP API is still pending.
# Explicit mode required: mock or live; no automatic fallback.
QA_MODE=mock
# Official service/model configuration; never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Official one-attempt adapter disables thinking; no implicit SDK retries.
# Local CPU weights: explicit prepare_weights command; runtime never downloads.
EMBEDDING_MODEL_ID=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=models/bge-small-zh-v1.5
EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
# Paths relative to the selected env file directory. Files not created by check.
QA_DATA_PATH=data/knowledge.json
QA_SQLITE_PATH=runtime/sessions.sqlite3
QA_TRACE_PATH=runtime/traces
# Fixed executor caps; tool 6 stops immediately. Model request 8 is unreachable
# under the current single-action and one-format-correction rules.
QA_MAX_MODEL_CALLS=8
QA_MAX_TOOL_CALLS=6
# Positive configurable timeouts (seconds) and estimated history token budget.
QA_MODEL_TIMEOUT_SECONDS=60
QA_TASK_TIMEOUT_SECONDS=300
QA_HISTORY_TOKEN_BUDGET=8000
